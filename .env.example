# Proveedor de pago: "mock" (pruebas, no cobra), "mercadopago" o "dlocalgo"
PAYMENT_PROVIDER=mock

# URL pública del sitio (para las URLs de retorno del pago y el webhook)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mercado Pago (https://www.mercadopago.cl/developers/panel/app > Credenciales de producción)
# Solo si PAYMENT_PROVIDER=mercadopago. Con MP_SANDBOX=true usa el enlace de pruebas.
MP_ACCESS_TOKEN=
MP_SANDBOX=false

# dLocal Go (https://dashboard.dlocalgo.com) — solo si PAYMENT_PROVIDER=dlocalgo
DLOCALGO_API_KEY=
DLOCALGO_SECRET_KEY=
DLOCALGO_SANDBOX=true

# Base de datos Postgres (Neon, Supabase, Vercel Postgres…). Obligatoria en producción.
# Sin ella, en desarrollo se usa un Postgres embebido guardado en .data/pglite.
DATABASE_URL=

# Correos (https://resend.com). Sin RESEND_API_KEY los correos se imprimen en consola.
RESEND_API_KEY=
EMAIL_FROM="CEPPICAR <pedidos@tudominio.cl>"
ORDERS_NOTIFY_EMAIL=

# Clave para entrar a /admin
ADMIN_PASSWORD=

# Fotos de productos subidas desde /admin (Vercel: Storage > Create Database > Blob lo agrega solo)
BLOB_READ_WRITE_TOKEN=
